<%- include('../includes/head.ejs') %>
<body>
  <%- include('../includes/nav.ejs') %>
  <main>
   <% if (orders.length <= 0 ) { %>
      <h1>No orders</h1>
    <% } else { %>
      <ul>
        <% orders.forEach(order => { %>
          <li>
            <h1>Order - <%= order._id %></h1>
            <ul>
              <% order.items.products.forEach(product => { %>
                <li>
                  <%= product.title %> (<%= product.quantity %>)
                </li>
              <% }); %>
            </ul>
          </li>
    <% }); %>
      </ul>
    <% } %>
  </main>
  <%- include('../includes/end.ejs') %>
</body>

